<Window x:Class="GameBoyCEmulator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameBoyCEmulator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">
    <DockPanel>
        <Menu DockPanel.Dock="Top" x:Name="MenuContainer">
            <MenuItem Header="_File">
                <MenuItem Header="_Open ROM" Click="OpenROM"></MenuItem>
                <MenuItem Header="_Save State" Click="SaveState"></MenuItem>
                <MenuItem Header="_Load State" Click="LoadState"></MenuItem>
                <MenuItem Header="_Remove Save State" Click="RemoveState"></MenuItem>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Settings" Click="OpenSettings">
                </MenuItem>
            </MenuItem>
        </Menu>
        <Grid Background="Black" x:Name="ScreenContainer">
            <Image x:Name="Screen" HorizontalAlignment="Center" Height="144" Margin="0,0,0,0" VerticalAlignment="Center" Width="160" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform">
            </Image>

        </Grid>
    </DockPanel>
</Window>
